{
  "name": "eurocup3-content-manager",
  "version": "1.3.28",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "test:e2e": "playwright test",
    "helper:build": "dotnet build helper/Eurocup3.Helper.csproj -c Release",
    "helper:test": "dotnet run --project helper.tests/Eurocup3.Helper.Tests.csproj -c Release",
    "demo": "node scripts/demo.mjs",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.2",
    "prettier": "^3.9.9",
    "semver": "^7.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
