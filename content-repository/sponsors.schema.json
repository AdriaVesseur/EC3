{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EC3 sponsors",
  "type": "object",
  "additionalProperties": false,
  "required": ["sponsors"],
  "properties": {
    "sponsors": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "logo", "url"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "logo": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^\\s@\\\\]+$", "description": "Public HTTPS image URL without credentials."},
          "url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^\\s@\\\\]+$", "description": "Required HTTPS website opened when the logo is clicked."},
          "order": {"type": "integer", "minimum": 0, "maximum": 10000, "default": 0}
        }
      }
    }
  }
}
