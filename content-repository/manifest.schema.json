{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["championship", "season", "build", "content"],
  "properties": {
    "championship": { "type": "string", "minLength": 1 },
    "season": { "type": "string", "pattern": "^[0-9]{4}$" },
    "build": { "$ref": "#/definitions/version" },
    "demo": { "type": "boolean" },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/definitions/package" }
    }
  },
  "definitions": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "relative": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[<>:\"|?*])(?!.*//)[^\\u0000-\\u001f]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/definitions/relative" },
        "sha256": { "$ref": "#/definitions/hash" },
        "size": { "type": "integer", "minimum": 0, "maximum": 8589934592 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "version",
        "download",
        "required",
        "description",
        "changelog"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "enum": ["car", "track", "app", "config"] },
        "version": { "$ref": "#/definitions/version" },
        "download": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/download/"
        },
        "icon": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)(?!.*[\\\\\\s])[^/?#]+(?:[/?#].*)?$"
        },
        "image": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?![^/?#]*@)(?!.*[\\\\\\s])[^/?#]+(?:[/?#].*)?$"
        },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "changelog": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
