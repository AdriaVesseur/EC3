{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EC3 configured Assetto Corsa servers",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers"],
  "properties": {
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "host", "httpPort"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "host": {"type": "string", "minLength": 1, "maxLength": 253, "description": "Public IP address or hostname only; no URL, credentials or port. A private LAN address requires allowLan: true. Loopback, link-local and cloud metadata addresses are always blocked."},
          "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "The AC server HTTP port (typically 8081), not its UDP/TCP race port."},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "allowLan": {"type": "boolean", "default": false},
          "liveTimingUrl": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://[^\\s@\\\\]+$", "description": "Public HTTPS live timing page. The helper does not fetch this URL."},
          "embedTiming": {"type": "boolean", "default": false, "description": "Enable only if the timing website explicitly allows embedding in a frame."}
        },
        "allOf": [
          {
            "if": {"properties": {"embedTiming": {"const": true}}, "required": ["embedTiming"]},
            "then": {"required": ["liveTimingUrl"]}
          }
        ]
      }
    }
  }
}
