{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EC3 configured Assetto Corsa servers",
  "type": "object",
  "additionalProperties": false,
  "required": ["servers"],
  "properties": {
    "servers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "httpPort"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "ip": {
            "type": "string",
            "maxLength": 45,
            "description": "Recommended: a literal public IPv4 or IPv6 address without brackets, scheme, port or hostname. Private LAN addresses require allowLan: true; loopback, link-local and cloud metadata addresses remain blocked.",
            "oneOf": [
              {"format": "ipv4", "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.(?:0|[1-9][0-9]{0,2})){3}$"},
              {"format": "ipv6", "pattern": "^[0-9A-Fa-f:.]+$"}
            ]
          },
          "host": {"type": "string", "minLength": 1, "maxLength": 253, "description": "Legacy field for existing configurations: IP address or hostname only, never together with ip. Prefer ip in new configurations. A private LAN address requires allowLan: true."},
          "httpPort": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "The AC server HTTP port (typically 8081), not its UDP/TCP race port."},
          "description": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
          "allowLan": {"type": "boolean", "default": false},
          "liveTimingUrl": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^(?:https://[^\\s@\\\\]+|http://(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?::[0-9]{1,5})?/[^\\s@\\\\]*\\.json(?:\\?[^\\s@\\\\]*)?)$", "description": "HTTPS timing page, or a JSON leaderboard API. HTTP is supported only for a public literal IPv4 JSON endpoint."},
          "embedTiming": {"type": "boolean", "default": false, "description": "Enable only if the timing website explicitly allows embedding in a frame."}
        },
        "oneOf": [
          {"required": ["ip"], "not": {"required": ["host"]}},
          {"required": ["host"], "not": {"required": ["ip"]}}
        ],
        "allOf": [
          {
            "if": {"properties": {"embedTiming": {"const": true}}, "required": ["embedTiming"]},
            "then": {"required": ["liveTimingUrl"]}
          }
        ]
      }
    }
  }
}
