{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "season",
    "build",
    "minimumHelperVersion",
    "requiredContent",
    "events"
  ],
  "properties": {
    "season": { "type": "string", "pattern": "^[0-9]{4}$" },
    "build": { "type": "string" },
    "minimumHelperVersion": { "type": "string" },
    "resultsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(www\\.)?makrobeasts\\.com/championships/"
    },
    "requiredContent": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "venue", "round", "requiredContent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "venue": { "type": "string", "minLength": 1 },
          "round": { "type": "string", "minLength": 1 },
          "requiredContent": {
            "type": "array",
      "minItems": 0,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
