{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EC3 teams",
  "type": "object",
  "additionalProperties": false,
  "required": ["teams"],
  "properties": {
    "teams": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "color",
          "logo",
          "driverNames",
          "liveTimingNames"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Team color in #RRGGBB format."
          },
          "logo": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "pattern": "^https://[^\\s@\\\\]+$",
            "description": "Public HTTPS logo image URL."
          },
          "driverNames": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "description": "Exact driver names from championship standings and results."
          },
          "liveTimingNames": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "description": "Team names reported by the Assetto Corsa live timing API."
          }
        }
      }
    }
  }
}
